# Vercel Deployment Ignore
# Exclude build tools, scratch scripts, audit files, and internal docs from production publish

builder/
scripts/
scratch/
audit/
node_modules/
.git/
.github/

# Documentation and scratch files
*.md
*.log
*.tmp
live.html

# Configuration and dependency files (build-time only)
site.config.js
site.config.json
package.json
package-lock.json

# Firebase / rules (not for public hosting)
firestore.rules
firebase.json
android-partner/
android-app/
android-release/

# Print catalog (source + PDF), not part of the website
catalog/

# Signed agreements / MoUs, not part of the website
agreements/
